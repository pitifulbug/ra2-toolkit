<Window x:Class="FloatingOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RA2 Toolkit 悬浮窗"
        Width="340" Height="600"
        WindowStyle="None"
        WindowStartupLocation="Manual"
        ResizeMode="NoResize"
        AllowsTransparency="False"
        Background="{DynamicResource {x:Static SystemColors.ControlBrushKey}}"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolVisibility" />
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <DockPanel Margin="0,0,0,6" Background="Transparent"
                       MouseLeftButtonDown="DragWindow_MouseLeftButtonDown">
                <Button DockPanel.Dock="Right"
                        Content="退出"
                        Focusable="False"
                        Command="{Binding ExitCommand}"
                        Margin="4,0,0,0"
                        Padding="8,1" />
                <Button x:Name="CollapseButton"
                        DockPanel.Dock="Right"
                        Content="收起"
                        Focusable="False"
                        Click="ToggleCollapsed_Click"
                        Padding="8,1" />
                <TextBlock x:Name="CategoryTitle"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>
            <ItemsControl ItemsSource="{Binding FeatureGroups}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Content="{Binding Title}"
                                Focusable="False"
                                Click="SelectGroup_Click"
                                Margin="1,0"
                                Padding="2" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <DockPanel Margin="0,6,0,0">
                <Button DockPanel.Dock="Left"
                        Content="{Binding VersionText}"
                        Command="{Binding CheckUpdatesCommand}"
                        Focusable="False"
                        Padding="5,1"
                        ToolTip="点击检查更新" />
                <Button DockPanel.Dock="Right"
                        Content="查看更新"
                        Command="{Binding OpenReleaseCommand}"
                        Focusable="False"
                        Margin="4,0,0,0"
                        Padding="5,1"
                        Visibility="{Binding HasAvailableRelease, Converter={StaticResource BoolVisibility}}" />
                <TextBlock Text="{Binding UpdateText}"
                           Margin="6,0,0,0"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding UpdateText}" />
            </DockPanel>
        </StackPanel>

        <ContentControl x:Name="FeatureContent" Grid.Row="1">
            <ContentControl.ContentTemplate>
                <DataTemplate>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding ToggleFeatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,3,0,7"
                                              IsEnabled="{Binding IsAvailable}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      Content="{Binding Title}"
                                                      IsChecked="{Binding IsActive, Mode=OneWay}"
                                                      Command="{Binding PrimaryCommand}"
                                                      Focusable="False"
                                                      ToolTip="{Binding Description}"
                                                      Margin="0,0,4,0" />
                                            <Button Grid.Column="1"
                                                    Content="{Binding HotkeyText}"
                                                    Command="{Binding CaptureHotkeyCommand}"
                                                    Focusable="False"
                                                    ToolTip="点击后按下快捷键；Esc 取消，Delete 清除" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ActionFeatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6"
                                              IsEnabled="{Binding IsAvailable}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="120" />
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0"
                                                    Content="{Binding Title}"
                                                    Command="{Binding PrimaryCommand}"
                                                    Focusable="False"
                                                    ToolTip="{Binding Description}"
                                                    HorizontalContentAlignment="Left"
                                                    Margin="0,0,4,0" />
                                            <Button Grid.Column="1"
                                                    Content="{Binding HotkeyText}"
                                                    Command="{Binding CaptureHotkeyCommand}"
                                                    Focusable="False"
                                                    ToolTip="点击后按下快捷键；Esc 取消，Delete 清除" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding NumberFeatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6"
                                              IsEnabled="{Binding IsAvailable}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="58" />
                                                <ColumnDefinition Width="28" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       ToolTip="{Binding Description}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1"
                                                    Content="−"
                                                    Focusable="False"
                                                    Command="{Binding DecreaseNumberCommand}" />
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding NumberText}"
                                                       TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="3"
                                                    Content="+"
                                                    Focusable="False"
                                                    Command="{Binding IncreaseNumberCommand}" />
                                            <Button Grid.Column="4"
                                                    Content="应用"
                                                    Focusable="False"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding PrimaryCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding ChoiceFeatures}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,6"
                                              IsEnabled="{Binding IsAvailable}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="48" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding Title}"
                                                       ToolTip="{Binding Description}"
                                                       VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding Choices}"
                                                      SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                                      DisplayMemberPath="Label"
                                                      Focusable="False" />
                                            <Button Grid.Column="2"
                                                    Content="应用"
                                                    Focusable="False"
                                                    Margin="4,0,0,0"
                                                    Command="{Binding PrimaryCommand}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </DataTemplate>
            </ContentControl.ContentTemplate>
        </ContentControl>

    </Grid>
</Window>
